<?xml version="1.0" encoding="utf-8"?>
<!--
  OUR AppLocker exceptions for the PSM (CyberArk PSMConfigureAppLocker.xml format).

  REPLACE this example with your own file - e.g. the production
  D:\CyberArk\PSM\Hardening\PSMConfigureAppLocker.xml as is - and KEEP it when
  copying a new version of PSM-Deploy over the sources.

  Before every Hardening stage (deployment, -RedoHardening, -Upgrade) the script
  compares the file IN PLACE on the server (<PSM>\Hardening\PSMConfigureAppLocker.xml:
  CyberArk's default after an install/upgrade, or already customized) with this
  one, and only ADDS the <Application> entries it does not have yet (same Type +
  Path = already there), each preceded by a <!- - custom - -> comment. Nothing is
  removed or changed in the server's file. An entry whose file is missing on the
  server is left out with an alert. The RunApplocker step then applies the file.

  Only the <Application> lines are read; this example has none (= CyberArk's
  file is used as is). Example of entries (uncomment / adapt):
    <Application Name="SqlPlus" Type="Exe" Path="D:\oracle\instantclient\sqlplus.exe" Method="Hash" />
    <Application Name="SqlDev"  Type="Exe" Path="D:\DBA\SQLDEVELOPPEUR_19.1\sqldeveloper\sqldeveloper\bin\sqldeveloper64.exe" Method="Hash" />
  Any binary added in config\software.psd1 that PSM sessions run must be listed here.
-->
<PSMAppLockerConfiguration>
  <AllowedApplications>
  </AllowedApplications>
</PSMAppLockerConfiguration>

# Sorties d'execution (jamais versionnees)
logs/*
!logs/.gitkeep
state/*
!state/.gitkeep

# Media et binaires (volumineux / licencies : deposes au moment du deploiement)
media/*
!media/.gitkeep
installers/*
!installers/.gitkeep

# Artefacts de la démo (générés à l'exécution)
demo/.demo-state/
demo/.demo-logs/

# Ne jamais committer de secret / credential file
*.cred
*.pfx
*.key
